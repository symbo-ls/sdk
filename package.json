{
  "name": "@symbo.ls/sdk",
  "version": "3.14.344",
  "type": "module",
  "source": "./src/index.js",
  "module": "./dist/esm/src/index.js",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "symbols-sdk": "./bin/sdk.js"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "tsconfig.json",
    "*.md",
    "LICENSE",
    "!src/**/*.test.js",
    "!src/**/tests/**",
    "!src/docs/**",
    "bin/**/*.js",
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/esm/src/index.js",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json",
    "./environment": {
      "development": "./src/config/environment.js",
      "import": "./dist/esm/src/config/environment.js",
      "default": "./dist/esm/src/config/environment.js"
    },
    "./federation": {
      "development": "./src/federation/index.js",
      "import": "./dist/esm/src/federation/index.js",
      "default": "./dist/esm/src/federation/index.js"
    },
    "./utils/services": {
      "development": "./src/utils/services.js",
      "import": "./dist/esm/src/utils/services.js",
      "default": "./dist/esm/src/utils/services.js"
    }
  },
  "scripts": {
    "build:esm": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=es2022 --format=esm --outbase=. --outdir=dist/esm --minify --log-level=warning",
    "build:node": "esbuild $(find src -name '*.js' ! -name '*.test.js') --target=node16 --format=esm --platform=node --outdir=dist/node --define:process.env.NODE_ENV=process.env.NODE_ENV",
    "build:types": "tsc -p tsconfig.json || echo '::warning::tsc exited non-zero — type declarations may be incomplete (publish proceeds; fix as separate work)'",
    "build": "rimraf dist && npm run build:esm && npm run build:types",
    "watch": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=es2022 --format=esm --outbase=. --outdir=dist/esm --watch=forever --log-level=warning",
    "prepublishOnly": "npm run build",
    "_inf": "infisical run --domain=https://km.api.symbols.app/api --projectId=58275b78-1549-4c3b-bdd5-6bedc6af0430 --env=${NODE_ENV:-upcoming} --",
    "test:all": "bun run _inf -- tape integration-tests/index.js integration-tests/*.test.js | tap-spec",
    "test:smoke": "bun run _inf -- tape integration-tests/index.js integration-tests/smoke/*.test.js | tap-spec",
    "test:auth": "bun run _inf -- tape integration-tests/index.js integration-tests/auth/*.test.js | tap-spec",
    "test:branch": "bun run _inf -- tape integration-tests/index.js integration-tests/branch/*.test.js | tap-spec",
    "test:dataset": "bun run _inf -- tape integration-tests/index.js integration-tests/dataset/*.test.js | tap-spec",
    "test:external": "bun run _inf -- tape integration-tests/index.js integration-tests/external/*.test.js | tap-spec",
    "test:member": "bun run _inf -- tape integration-tests/index.js integration-tests/member/*.test.js | tap-spec",
    "test:password": "bun run _inf -- tape integration-tests/index.js integration-tests/password/*.test.js | tap-spec",
    "test:project": "bun run _inf -- tape integration-tests/index.js integration-tests/project/*.test.js | tap-spec",
    "test:get-project": "bun run _inf -- tape integration-tests/index.js integration-tests/get-project/*.test.js | tap-spec",
    "test:update-project": "bun run _inf -- tape integration-tests/index.js integration-tests/update-project/*.test.js | tap-spec",
    "test:favorite-project": "bun run _inf -- tape integration-tests/index.js integration-tests/favorite-project/*.test.js | tap-spec",
    "test:collab": "bun run _inf -- tape integration-tests/index.js integration-tests/collab/*.test.js | tap-spec",
    "test:user": "bun run _inf -- tape integration-tests/index.js integration-tests/user/*.test.js | tap-spec",
    "test:unit-all": "tape src/services/tests/**/*.test.js | tap-spec",
    "test:bridges": "tape packages/sdk-bridge/tests/*.test.js packages/sdk-supabase-bridge/tests/*.test.js | tap-spec"
  },
  "dependencies": {
    "@symbo.ls/channels": "^3.14.105",
    "@symbo.ls/utils": "^3.14.105",
    "@symbo.ls/analyzing": "^3.14.142",
    "@symbo.ls/workspace-project-supabase": "^3.14.344",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "chalk": "^5.4.1",
    "commander": "^12.0.0",
    "dexie": "^4.0.11",
    "dotenv": "^16.4.7",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.2",
    "socket.io-client": "^4.8.1",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.27"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@symbo.ls/sdk-bridge": "^3.14.142",
    "@symbo.ls/sdk-supabase-bridge": "^3.14.142"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@symbo.ls/sdk-bridge": {
      "optional": true
    },
    "@symbo.ls/sdk-supabase-bridge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.1",
    "@supabase/supabase-js": "^2.0.0",
    "esbuild": "^0.27.4",
    "esbuild-plugins-node-modules-polyfill": "^1.6.8",
    "glob": "^12.0.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "tap-parser": "^18.0.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.9.0"
  },
  "gitHead": "0be12bcdd99c265fdeded6d756a1a3616a943ffc",
  "packageManager": "bun@1.3.6",
  "publishConfig": {
    "access": "restricted"
  }
}
