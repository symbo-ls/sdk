{
  "name": "@symbo.ls/sdk-supabase-bridge",
  "version": "3.14.105",
  "type": "module",
  "description": "Supabase-flavoured federation bridge — multi-project auth, registry-driven client cache, edge-function login/logout/switch primitives. Built on @symbo.ls/sdk-bridge. Project-specific glue (org defaults, integrations, MCP) belongs in the consumer app.",
  "main": "./dist/cjs/src/index.cjs",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.cjs",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json",
    "./clients": {
      "development": "./src/clients.js",
      "import": "./dist/esm/src/clients.js",
      "require": "./dist/cjs/src/clients.cjs",
      "default": "./dist/esm/src/clients.js"
    },
    "./bridge": {
      "development": "./src/bridge.js",
      "import": "./dist/esm/src/bridge.js",
      "require": "./dist/cjs/src/bridge.cjs",
      "default": "./dist/esm/src/bridge.js"
    },
    "./env": {
      "development": "./src/env.js",
      "import": "./dist/esm/src/env.js",
      "require": "./dist/cjs/src/env.cjs",
      "default": "./dist/esm/src/env.js"
    },
    "./crossAppAuth": {
      "development": "./src/crossAppAuth.js",
      "import": "./dist/esm/src/crossAppAuth.js",
      "require": "./dist/cjs/src/crossAppAuth.cjs",
      "default": "./dist/esm/src/crossAppAuth.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "tsconfig.json",
    "*.md",
    "LICENSE",
    "README.md",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "test": "tape tests/*.test.js | tap-spec",
    "build:esm": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=es2022 --format=esm --outbase=. --outdir=dist/esm --minify --log-level=warning",
    "build:cjs": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=node20 --format=cjs --outbase=. --outdir=dist/cjs --out-extension:.js=.cjs --minify --log-level=warning",
    "build:types": "tsc -p tsconfig.json || echo '::warning::tsc exited non-zero — type declarations may be incomplete (publish proceeds; fix as separate work)'",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs && npm run build:types",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tap-spec": "^5.0.0",
    "tape": "^5.7.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "@symbo.ls/sdk-bridge": "^3.14.105"
  },
  "license": "CC-BY-NC-4.0",
  "repository": "https://github.com/symbo-ls/sdk",
  "publishConfig": {
    "access": "restricted"
  },
  "module": "./dist/esm/src/index.js"
}
