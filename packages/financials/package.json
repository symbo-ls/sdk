{
  "name": "@symbo.ls/sdk-financials",
  "version": "3.14.594",
  "type": "module",
  "description": "Financials extension for @symbo.ls/sdk \u2014 equity grants, compensation, investor profiles, valuations. Opt-in per tenant via Organization.enabledExtensions[]. Mongo-backed on the main API at /core/financials/*.",
  "main": "./dist/cjs/src/index.cjs",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.cjs",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build:esm": "esbuild ./src/index.js --bundle --keep-names --target=es2022 --format=esm --outfile=dist/esm/src/index.js --log-level=warning --external:@symbo.ls/*",
    "build:cjs": "esbuild ./src/index.js --bundle --keep-names --target=node20 --format=cjs --outfile=dist/cjs/src/index.cjs --log-level=warning --external:@symbo.ls/*",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs"
  },
  "peerDependencies": {
    "@symbo.ls/sdk": "^3.14.594"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "keywords": [
    "symbols",
    "sdk-extension",
    "financials",
    "equity",
    "compensation"
  ],
  "author": "Symbols Inc.",
  "license": "UNLICENSED"
}
