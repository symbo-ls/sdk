{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "strict": false,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist/types"
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.js",
    "tests/**"
  ]
}
