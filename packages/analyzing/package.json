{
  "name": "@symbo.ls/analyzing",
  "version": "3.14.142",
  "type": "module",
  "description": "Browser-side observability SDK for DOMQL apps — pipes @symbo.ls/analyze events (errors, console, network, perf, lifecycle, state) to the analyzed worker. Faro-compatible manual API (captureError / captureMessage / identify / setContext / addMeasurement).",
  "main": "./dist/cjs/src/index.cjs",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.cjs",
      "default": "./dist/esm/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "tsconfig.json",
    "*.md",
    "LICENSE",
    "README.md",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:esm": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/tests/*\" -not -name \"*.test.js\") --target=es2022 --format=esm --outbase=. --outdir=dist/esm --minify --log-level=warning",
    "build:cjs": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/tests/*\" -not -name \"*.test.js\") --target=node20 --format=cjs --outbase=. --outdir=dist/cjs --out-extension:.js=.cjs --minify --log-level=warning",
    "build:types": "tsc -p tsconfig.json || echo '::warning::tsc exited non-zero — type declarations may be incomplete (publish proceeds; fix as separate work)'",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs && npm run build:types",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@symbo.ls/analyze": "^3.14.105"
  },
  "license": "CC-BY-NC-4.0",
  "repository": "https://github.com/symbo-ls/sdk",
  "publishConfig": {
    "access": "restricted"
  },
  "module": "./dist/esm/src/index.js"
}
